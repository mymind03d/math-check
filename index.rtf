\f0\fs24 \cf0 <!DOCTYPE html>\
<html>\
<head>\
  <base target="_top">\
  <meta charset="UTF-8">\
  <title>\uc0\u3619 \u3632 \u3610 \u3610 \u3626 \u3649 \u3585 \u3609 \u3651 \u3610 \u3627 \u3609 \u3657 \u3634 \u3648 \u3594 \u3655 \u3588 \u3594 \u3639 \u3656 \u3629  \u3611 .6</title>\
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600&display=swap" rel="stylesheet">\
  <script src="https://cdn.tailwindcss.com"></script>\
  <script defer src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api/dist/face-api.js"></script>\
  <style>\
    body \{ font-family: 'Prompt', sans-serif; \}\
    #video-container \{ position: relative; \}\
  </style>\
</head>\
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col items-center p-4">\
\
  <header class="text-center my-6">\
    <h1 class="text-3xl font-bold text-indigo-600">\uc0\u3619 \u3632 \u3610 \u3610 \u3626 \u3649 \u3585 \u3609 \u3651 \u3610 \u3627 \u3609 \u3657 \u3634 \u3648 \u3594 \u3655 \u3588 \u3594 \u3639 \u3656 \u3629 \u3609 \u3633 \u3585 \u3648 \u3619 \u3637 \u3618 \u3609  \u3611 .6</h1>\
    <p class="text-slate-500 mt-2">\uc0\u3650 \u3619 \u3591 \u3648 \u3619 \u3637 \u3618 \u3609 \u3626 \u3634 \u3608 \u3636 \u3605 \u3617 \u3627 \u3634 \u3623 \u3636 \u3607 \u3618 \u3634 \u3621 \u3633 \u3618 \u3586 \u3629 \u3609 \u3649 \u3585 \u3656 \u3609  (\u3617 \u3629 \u3604 \u3636 \u3609 \u3649 \u3604 \u3591 )</p>\
  </header>\
\
  <main class="w-full max-w-5xl grid grid-cols-1 md:grid-cols-2 gap-6">\
    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 flex flex-col items-center">\
      <h2 class="text-lg font-medium mb-4 text-slate-700 flex items-center gap-2">\uc0\u55356 \u57253  \u3585 \u3621 \u3657 \u3629 \u3591 \u3626 \u3649 \u3585 \u3609 \u3651 \u3610 \u3627 \u3609 \u3657 \u3634 \u3629 \u3633 \u3605 \u3650 \u3609 \u3617 \u3633 \u3605 \u3636 </h2>\
      <div id="video-container" class="w-full aspect-video bg-black rounded-xl overflow-hidden relative shadow-inner">\
        <video id="video" width="640" height="480" autoplay muted playsinline class="w-full h-full object-cover"></video>\
      </div>\
      <div id="status-message" class="mt-4 p-2 px-4 rounded-full text-xs font-semibold bg-amber-50 text-amber-600 animate-pulse text-center">\
        \uc0\u3585 \u3635 \u3621 \u3633 \u3591 \u3650 \u3627 \u3621 \u3604 \u3619 \u3632 \u3610 \u3610  AI \u3649 \u3621 \u3632 \u3650 \u3617 \u3648 \u3604 \u3621 \u3651 \u3610 \u3627 \u3609 \u3657 \u3634  \u3585 \u3619 \u3640 \u3603 \u3634 \u3619 \u3629 \u3626 \u3633 \u3585 \u3588 \u3619 \u3641 \u3656 ...\
      </div>\
    </div>\
\
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex flex-col justify-between">\
      <div>\
        <h2 class="text-lg font-medium mb-4 text-slate-700">\uc0\u55357 \u56541  \u3621 \u3591 \u3607 \u3632 \u3648 \u3610 \u3637 \u3618 \u3609 \u3651 \u3610 \u3627 \u3609 \u3657 \u3634  / \u3610 \u3633 \u3609 \u3607 \u3638 \u3585 \u3626 \u3606 \u3634 \u3609 \u3632 \u3604 \u3657 \u3623 \u3618 \u3617 \u3639 \u3629 </h2>\
        <div class="mb-4">\
          <label class="block text-sm text-slate-500 mb-1">\uc0\u3648 \u3621 \u3639 \u3629 \u3585 \u3594 \u3639 \u3656 \u3629 \u3609 \u3633 \u3585 \u3648 \u3619 \u3637 \u3618 \u3609 </label>\
          <select id="student-select" class="w-full border border-slate-200 p-2.5 rounded-xl bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500">\
            <option value="">-- \uc0\u3585 \u3635 \u3621 \u3633 \u3591 \u3650 \u3627 \u3621 \u3604 \u3619 \u3634 \u3618 \u3594 \u3639 \u3656 \u3629 \u3609 \u3633 \u3585 \u3648 \u3619 \u3637 \u3618 \u3609  --</option>\
          </select>\
        </div>\
        <div class="grid grid-cols-2 gap-2 mb-4">\
          <button onclick="registerFace()" class="bg-emerald-600 text-white py-2.5 rounded-xl font-medium hover:bg-emerald-700 transition shadow-sm">\uc0\u55357 \u56568  \u3621 \u3591 \u3607 \u3632 \u3648 \u3610 \u3637 \u3618 \u3609 \u3619 \u3641 \u3611 \u3627 \u3609 \u3657 \u3634 \u3651 \u3627 \u3617 \u3656 </button>\
          <button onclick="manualCheckInWithStatus('\uc0\u3617 \u3634 \u3611 \u3585 \u3605 \u3636 ')" class="bg-blue-600 text-white py-2.5 rounded-xl font-medium hover:bg-blue-700 transition shadow-sm">\u10004  \u3648 \u3594 \u3655 \u3588 \u3594 \u3639 \u3656 \u3629  "\u3617 \u3634 \u3611 \u3585 \u3605 \u3636 " (\u3585 \u3604 \u3617 \u3639 \u3629 )</button>\
        </div>\
        <div class="block text-xs font-medium text-slate-400 mb-2 uppercase tracking-wider">\uc0\u3610 \u3633 \u3609 \u3607 \u3638 \u3585 \u3626 \u3606 \u3634 \u3609 \u3632 \u3629 \u3639 \u3656 \u3609 \u3654  (\u3626 \u3656 \u3591 \u3652 \u3621 \u3609 \u3660 \u3627 \u3634 \u3612 \u3641 \u3657 \u3611 \u3585 \u3588 \u3619 \u3629 \u3591 \u3607 \u3633 \u3609 \u3607 \u3637 ):</div>\
        <div class="grid grid-cols-3 gap-2 mb-6">\
          <button onclick="manualCheckInWithStatus('\uc0\u3621 \u3634 ')" class="bg-amber-500 text-white py-2.5 rounded-xl font-medium hover:bg-amber-600 transition shadow-sm">\u55357 \u57313  \u3621 \u3634 </button>\
          <button onclick="manualCheckInWithStatus('\uc0\u3611 \u3656 \u3623 \u3618 ')" class="bg-orange-500 text-white py-2.5 rounded-xl font-medium hover:bg-orange-600 transition shadow-sm">\u55357 \u57312  \u3611 \u3656 \u3623 \u3618 </button>\
          <button onclick="manualCheckInWithStatus('\uc0\u3586 \u3634 \u3604 ')" class="bg-rose-500 text-white py-2.5 rounded-xl font-medium hover:bg-rose-600 transition shadow-sm">\u55357 \u56628  \u3586 \u3634 \u3604 \u3648 \u3619 \u3637 \u3618 \u3609 </button>\
        </div>\
      </div>\
      <div id="result-box" class="border-t border-slate-100 pt-4 hidden">\
        <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-xl text-center">\
          <h3 class="font-bold text-emerald-700 text-xl" id="res-name">-</h3>\
          <p class="text-sm text-emerald-600 mt-1" id="res-detail">-</p>\
        </div>\
      </div>\
    </div>\
  </main>\
\
  <script>\
    // \uc0\u55357 \u56599  \u3623 \u3634 \u3591 \u3621 \u3636 \u3591 \u3585 \u3660 \u3626 \u3588 \u3619 \u3636 \u3611 \u3605 \u3660  /exec \u3605 \u3633 \u3623 \u3651 \u3627 \u3617 \u3656 \u3586 \u3629 \u3591 \u3588 \u3640 \u3603 \u3588 \u3619 \u3641 \u3605 \u3619 \u3591 \u3609 \u3637 \u3657 \u3588 \u3619 \u3633 \u3610 \
    const BACKEND_URL = "\uc0\u3585 https://script.googleusercontent.com/macros/echo?user_content_key=AUkAhnRbS-AAjGMLmFFCMJhCKtXRXuXAHY12RROxyqciT0aCbr3zuoWfVYm-acmjPKI7La4uq_CpO62Wj9dijk58AwmIS6nppdumaWvQbwrN4p_7OY8Far_JCBwRlpv-EpgKFmGle-eucOFULn_8FKibBch349fU29Lc_4yM8UGvvNqWwksQWDOE_phyZBOc69i7x2MVtriuWmYC9Rm8xH8m0BT6s6VWGHK-AUM3qbQ7PJuejgW-EL5kBw_JMFn8EZXL5hpp0q1rqDdcvnCVlYUf8kHyO7diOA&lib=Ml38aqEqIDCwOuHTerqOB3SkLkff0V_EX"; \
\
    const video = document.getElementById('video');\
    const statusMsg = document.getElementById('status-message');\
    let localStudents = [];\
    let faceMatcher = null;\
\
    // \uc0\u3615 \u3633 \u3591 \u3585 \u3660 \u3594 \u3633 \u3609 \u3626 \u3656 \u3623 \u3609 \u3585 \u3621 \u3634 \u3591 \u3626 \u3635 \u3627 \u3619 \u3633 \u3610 \u3648 \u3619 \u3637 \u3618 \u3585 \u3588 \u3640 \u3618 \u3585 \u3633 \u3610 \u3627 \u3621 \u3633 \u3591 \u3610 \u3657 \u3634 \u3609  Google Sheets\
    async function callBackend(payload) \{\
      const response = await fetch(BACKEND_URL, \{\
        method: "POST",\
        body: JSON.stringify(payload)\
      \});\
      return await response.json();\
    \}\
\
    async function initSystem() \{\
      statusMsg.innerText = "\uc0\u9203  \u3585 \u3635 \u3621 \u3633 \u3591 \u3650 \u3627 \u3621 \u3604 \u3650 \u3617 \u3648 \u3604 \u3621 \u3605 \u3619 \u3623 \u3592 \u3592 \u3633 \u3610 \u3651 \u3610 \u3627 \u3609 \u3657 \u3634 \u3592 \u3634 \u3585 \u3619 \u3632 \u3610 \u3610 ...";\
      const MODEL_URL = 'https://cdn.jsdelivr.net/npm/@vladmandic/face-api/model/';\
      await faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL);\
      await faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL);\
      await faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL);\
      statusMsg.innerText = "\uc0\u9203  \u3650 \u3617 \u3648 \u3604 \u3621 \u3614 \u3619 \u3657 \u3629 \u3617 \u3649 \u3621 \u3657 \u3623  \u3585 \u3635 \u3621 \u3633 \u3591 \u3648 \u3594 \u3639 \u3656 \u3629 \u3617 \u3605 \u3656 \u3629 \u3585 \u3621 \u3657 \u3629 \u3591 ...";\
      startVideo();\
      loadStudents();\
    \}\
\
    function startVideo() \{\
      navigator.mediaDevices.getUserMedia(\{ video: \{ facingMode: "user", width: \{ ideal: 640 \}, height: \{ ideal: 480 \} \} \})\
      .then(stream => \{\
        video.srcObject = stream;\
        statusMsg.innerText = "\uc0\u55357 \u57314  \u3619 \u3632 \u3610 \u3610 \u3626 \u3649 \u3585 \u3609 \u3651 \u3610 \u3627 \u3609 \u3657 \u3634 \u3614 \u3619 \u3657 \u3629 \u3617 \u3607 \u3635 \u3591 \u3634 \u3609 \u3649 \u3621 \u3657 \u3623 \u3588 \u3619 \u3633 \u3610 ";\
        statusMsg.className = "mt-4 p-2 px-4 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-600 text-center";\
        video.addEventListener('play', () => \{ setInterval(recognizeFace, 2500); \});\
      \})\
      .catch(err => \{\
        statusMsg.innerText = "\uc0\u10060  \u3648 \u3611 \u3636 \u3604 \u3585 \u3621 \u3657 \u3629 \u3591 \u3652 \u3617 \u3656 \u3626 \u3635 \u3648 \u3619 \u3655 \u3592  \u3585 \u3619 \u3640 \u3603 \u3634 \u3585 \u3604 \u3629 \u3609 \u3640 \u3597 \u3634 \u3605 \u3651 \u3627 \u3657 \u3626 \u3636 \u3607 \u3608 \u3636 \u3660 \u3648 \u3586 \u3657 \u3634 \u3606 \u3638 \u3591 \u3585 \u3621 \u3657 \u3629 \u3591 ";\
        statusMsg.className = "mt-4 p-2 px-4 rounded-full text-xs font-semibold bg-rose-50 text-rose-600 text-center";\
      \});\
    \}\
\
    async function loadStudents() \{\
      try \{\
        const students = await callBackend(\{ action: "getStudentList" \});\
        localStudents = students;\
        const select = document.getElementById('student-select');\
        select.innerHTML = '<option value="">-- \uc0\u3648 \u3621 \u3639 \u3629 \u3585 \u3619 \u3634 \u3618 \u3594 \u3639 \u3656 \u3629 \u3609 \u3633 \u3585 \u3648 \u3619 \u3637 \u3618 \u3609  --</option>';\
        const labeledDescriptors = [];\
\
        students.forEach(s => \{\
          let opt = document.createElement('option');\
          opt.value = s.no;\
          opt.innerText = `\uc0\u3648 \u3621 \u3586 \u3607 \u3637 \u3656  $\{s.no\} - $\{s.name\} ($\{s.nickname\})`;\
          select.appendChild(opt);\
\
          if(s.faceToken) \{\
            try \{\
              const arr = new Float32Array(JSON.parse(s.faceToken));\
              labeledDescriptors.push(new faceapi.LabeledFaceDescriptors(s.no.toString(), [arr]));\
            \} catch(e) \{ console.error(e); \}\
          \}\
        \});\
\
        if(labeledDescriptors.length > 0) \{\
          faceMatcher = new faceapi.FaceMatcher(labeledDescriptors, 0.55);\
        \}\
      \} catch (err) \{ statusMsg.innerText = "\uc0\u10060  \u3650 \u3627 \u3621 \u3604 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3609 \u3633 \u3585 \u3648 \u3619 \u3637 \u3618 \u3609 \u3621 \u3657 \u3617 \u3648 \u3627 \u3621 \u3623 "; \}\
    \}\
\
    async function recognizeFace() \{\
      if(!faceMatcher || isProcessing) return;\
      const detections = await faceapi.detectAllFaces(video, new faceapi.TinyFaceDetectorOptions()).withFaceLandmarks().withFaceDescriptors();\
      if(detections.length > 0) \{\
        detections.forEach(detection => \{\
          const bestMatch = faceMatcher.findBestMatch(detection.descriptor);\
          if(bestMatch.label !== 'unknown') \{\
            const student = localStudents.find(s => s.no == bestMatch.label);\
            if(student) triggerCheckIn(student, null);\
          \}\
        \});\
      \}\
    \}\
\
    let isProcessing = false;\
    async function triggerCheckIn(student, customStatus = null) \{\
      if(isProcessing) return;\
      isProcessing = true;\
      statusMsg.innerText = `\uc0\u55357 \u56596  \u3585 \u3635 \u3621 \u3633 \u3591 \u3610 \u3633 \u3609 \u3607 \u3638 \u3585 \u3626 \u3606 \u3634 \u3609 \u3586 \u3657 \u3629 \u3617 \u3641 \u3621 \u3586 \u3629 \u3591  $\{student.name\}...`;\
\
      try \{\
        const res = await callBackend(\{ action: "checkAttendance", studentData: student, customStatus: customStatus \});\
        const resultBox = document.getElementById('result-box');\
        const resultDiv = resultBox.firstElementChild;\
        resultBox.classList.remove('hidden');\
        document.getElementById('res-name').innerText = `\uc0\u55356 \u57225  $\{student.name\} ($\{student.nickname\})`;\
        \
        resultDiv.className = "p-4 border rounded-xl text-center ";\
        if(res.studentStatus === "\uc0\u3617 \u3634 \u3611 \u3585 \u3605 \u3636 ") resultDiv.classList.add("bg-emerald-50", "border-emerald-200", "text-emerald-700");\
        else if(res.studentStatus === "\uc0\u3626 \u3634 \u3618 ") resultDiv.classList.add("bg-yellow-50", "border-yellow-200", "text-yellow-700");\
        else if(res.studentStatus === "\uc0\u3621 \u3634 " || res.studentStatus === "\u3611 \u3656 \u3623 \u3618 ") resultDiv.classList.add("bg-amber-50", "border-amber-200", "text-amber-700");\
        else resultDiv.classList.add("bg-rose-50", "border-rose-200", "text-rose-700");\
\
        document.getElementById('res-detail').innerText = `\uc0\u3610 \u3633 \u3609 \u3607 \u3638 \u3585 \u3626 \u3606 \u3634 \u3609 \u3632 : $\{res.studentStatus\} \u3626 \u3635 \u3648 \u3619 \u3655 \u3592  \u3648 \u3623 \u3621 \u3634 : $\{res.time\} \u3609 .`;\
        statusMsg.innerText = `\uc0\u10004  \u3610 \u3633 \u3609 \u3607 \u3638 \u3585 \u3648 \u3623 \u3621 \u3634 \u3648 \u3619 \u3637 \u3618 \u3609 \u3626 \u3635 \u3648 \u3619 \u3655 \u3592 \u3649 \u3621 \u3657 \u3623 `;\
        setTimeout(() => \{ isProcessing = false; \}, 4000);\
      \} catch (err) \{ statusMsg.innerText = "\uc0\u10060  \u3610 \u3633 \u3609 \u3607 \u3638 \u3585 \u3612 \u3621 \u3621 \u3657 \u3617 \u3648 \u3627 \u3621 \u3623 "; isProcessing = false; \}\
    \}\
\
    async function registerFace() \{\
      const studentNo = document.getElementById('student-select').value;\
      if(!studentNo) \{ alert("\uc0\u3585 \u3619 \u3640 \u3603 \u3634 \u3648 \u3621 \u3639 \u3629 \u3585 \u3619 \u3634 \u3618 \u3594 \u3639 \u3656 \u3629 \u3609 \u3633 \u3585 \u3648 \u3619 \u3637 \u3618 \u3609 \u3585 \u3656 \u3629 \u3609 \u3588 \u3619 \u3633 \u3610 "); return; \}\
      statusMsg.innerText = "\uc0\u55357 \u56568  \u3585 \u3635 \u3621 \u3633 \u3591 \u3611 \u3619 \u3632 \u3617 \u3623 \u3621 \u3612 \u3621 \u3592 \u3633 \u3604 \u3648 \u3585 \u3655 \u3610 \u3614 \u3636 \u3585 \u3633 \u3604 \u3651 \u3610 \u3627 \u3609 \u3657 \u3634 ...";\
      const detection = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions()).withFaceLandmarks().withFaceDescriptor();\
\
      if(detection) \{\
        const tokenArray = Array.from(detection.descriptor);\
        try \{\
          const res = await callBackend(\{ action: "saveFaceToken", studentNo: studentNo, faceTokenString: JSON.stringify(tokenArray) \});\
          alert(res.message);\
          loadStudents();\
        \} catch(err) \{ alert("\uc0\u10060  \u3621 \u3591 \u3607 \u3632 \u3648 \u3610 \u3637 \u3618 \u3609 \u3621 \u3657 \u3617 \u3648 \u3627 \u3621 \u3623 "); \}\
      \} else \{ alert("\uc0\u10060  \u3605 \u3619 \u3623 \u3592 \u3652 \u3617 \u3656 \u3614 \u3610 \u3651 \u3610 \u3627 \u3609 \u3657 \u3634  \u3585 \u3619 \u3640 \u3603 \u3634 \u3618 \u3639 \u3609 \u3627 \u3609 \u3657 \u3634 \u3605 \u3619 \u3591 \u3649 \u3621 \u3657 \u3623 \u3621 \u3629 \u3591 \u3651 \u3627 \u3617 \u3656 \u3588 \u3619 \u3633 \u3610 "); \}\
    \}\
\
    function manualCheckInWithStatus(selectedStatus) \{\
      const studentNo = document.getElementById('student-select').value;\
      if(!studentNo) \{ alert("\uc0\u3585 \u3619 \u3640 \u3603 \u3634 \u3648 \u3621 \u3639 \u3629 \u3585 \u3594 \u3639 \u3656 \u3629 \u3609 \u3633 \u3585 \u3648 \u3619 \u3637 \u3618 \u3609 \u3585 \u3656 \u3629 \u3609 \u3588 \u3619 \u3633 \u3610 \u3588 \u3640 \u3603 \u3588 \u3619 \u3641 "); return; \}\
      const student = localStudents.find(s => s.no == studentNo);\
      if(student) triggerCheckIn(student, selectedStatus);\
    \}\
\
    window.onload = initSystem;\
  </script>\
</body>\
</html>}